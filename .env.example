# Delivery Helper - deployment configuration.
#
# Copy this file to .env alongside docker-compose.yml and fill it in. .env holds API
# tokens, which are passwords: it is git-ignored and must never be committed or shared.

# --- Jira ------------------------------------------------------------------------------
# The one site everybody's tokens authenticate against.
JIRA_SITE=https://your-site.atlassian.net


# --- Per-user API tokens ----------------------------------------------------------------
# One token per person who can sign in. Each name here must match the
# "apiTokenEnvironmentVariable" of an entry in config/users.json - that file says who can
# sign in, this file holds their secrets.
#
# Each person creates their own token at:
#   https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN_JANE=paste-janes-api-token-here
# JIRA_API_TOKEN_SAM=paste-the-next-persons-token-here


# --- Optional per-user access codes ------------------------------------------------------
# Anyone who can reach the server can otherwise sign in as anyone listed. Set a code here
# and name it in that person's "accessCodeEnvironmentVariable" to require it.
# UAT_ACCESS_CODE_SAM=choose-something


# --- Session ------------------------------------------------------------------------------
# Signs the log-in cookie. Set it to a long random string and leave it alone - changing it
# signs everyone out. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
UAT_SECRET_KEY=generate-a-long-random-string-and-paste-it-here


# --- Server -------------------------------------------------------------------------------
# Defaults are fine; override only if something clashes.
# UAT_APPLICATION_NAME=Delivery Helper
# UAT_PORT=9090
# UAT_THREADS=8
# UAT_TIMEOUT_SECONDS=300
# UAT_LOG_LEVEL=info
# UAT_CACHE_MAX_AGE_SECONDS=25

# Set when running behind a reverse proxy that terminates TLS, so generated links use https.
# UAT_FORWARDED_ALLOW_IPS=*
